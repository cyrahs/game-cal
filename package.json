{
  "name": "game-cal",
  "private": true,
  "packageManager": "pnpm@9.9.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "review:upstream": "node scripts/review-upstream.mjs",
    "review:upstream:collect": "node scripts/review-upstream.mjs --collect-only",
    "autopatch": "node scripts/upstream-autopatch.mjs run",
    "test:upstream-review": "node --test scripts/review-upstream.test.mjs scripts/upstream-agentic-state.test.mjs scripts/upstream-agentic-artifact.test.mjs scripts/upstream-autopatch.test.mjs scripts/upstream-agentic-workflow.test.mjs",
    "test:upstream-agentic": "node --test scripts/upstream-agentic-state.test.mjs scripts/upstream-agentic-artifact.test.mjs scripts/upstream-autopatch.test.mjs scripts/upstream-agentic-workflow.test.mjs",
    "test:game-parsers": "pnpm --filter @game-cal/api test:game-parsers",
    "cf:dev": "pnpm --filter @game-cal/web build && wrangler dev",
    "cf:deploy": "pnpm --filter @game-cal/web build && wrangler deploy",
    "cf:deploy:dry": "pnpm --filter @game-cal/web build && wrangler deploy --dry-run",
    "cf:types": "wrangler types"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
