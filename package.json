{
  "name": "game-cal",
  "private": true,
  "packageManager": "pnpm@9.9.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "review:upstream": "node scripts/review-upstream.mjs",
    "review:upstream:collect": "node scripts/review-upstream.mjs --collect-only",
    "review:upstream:finalize": "node scripts/review-upstream.mjs --finalize",
    "review:upstream:prepare-fix": "node scripts/review-upstream.mjs --prepare-fix",
    "review:upstream:finalize-fix": "node scripts/review-upstream.mjs --finalize-fix",
    "review:upstream:prepare-pr-review": "node scripts/review-upstream.mjs --prepare-pr-review",
    "review:upstream:finalize-pr-review": "node scripts/review-upstream.mjs --finalize-pr-review",
    "test:upstream-review": "node --test scripts/review-upstream.test.mjs",
    "cf:dev": "pnpm --filter @game-cal/web build && wrangler dev",
    "cf:deploy": "pnpm --filter @game-cal/web build && wrangler deploy",
    "cf:deploy:dry": "pnpm --filter @game-cal/web build && wrangler deploy --dry-run",
    "cf:types": "wrangler types"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
