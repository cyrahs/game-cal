{
  "type": "object",
  "properties": {
    "complete": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "enum": [
          "apps/api/src/games/genshin.ts",
          "apps/api/src/games/starrail.ts",
          "apps/api/src/games/ww.ts",
          "apps/api/src/games/zzz.ts",
          "apps/api/src/games/snowbreak.ts",
          "apps/api/src/games/endfield.ts"
        ]
      }
    },
    "outcomes": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^finding-[0-9]{3}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "fixed",
              "not_fixed"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "status",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "complete",
    "errors",
    "summary",
    "changed_files",
    "outcomes"
  ],
  "additionalProperties": false
}
