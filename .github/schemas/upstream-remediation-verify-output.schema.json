{
  "type": "object",
  "properties": {
    "complete": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary": {
      "type": "string"
    },
    "outcomes": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^finding-[0-9]{3}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "resolved",
              "unresolved",
              "indeterminate"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "status",
          "confidence",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "complete",
    "errors",
    "input_sha256",
    "summary",
    "outcomes"
  ],
  "additionalProperties": false
}
