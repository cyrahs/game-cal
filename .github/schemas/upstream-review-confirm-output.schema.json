{
  "type": "object",
  "properties": {
    "complete": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decisions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^finding-[0-9]{3}$"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "confirmed",
              "rejected",
              "ambiguous"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "verdict",
          "confidence",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "complete",
    "errors",
    "input_sha256",
    "decisions"
  ],
  "additionalProperties": false
}
