{
  "type": "object",
  "properties": {
    "complete": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "resolved",
        "unresolved"
      ]
    },
    "summary": {
      "type": "string"
    },
    "outcomes": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^finding-[0-9]{3}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "resolved",
              "unresolved",
              "indeterminate"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "status",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "complete",
    "errors",
    "context_sha256",
    "verdict",
    "summary",
    "outcomes"
  ],
  "additionalProperties": false
}
